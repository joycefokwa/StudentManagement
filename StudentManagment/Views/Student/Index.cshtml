@model IEnumerable<StudentManagment.Models.Student>

@{
    ViewBag.Title = "Index";
}
@{
    ViewBag.Title = "Student";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">
    <h2 class="text-center mb-4"> Students List</h2>

    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Age</th>
                </tr>
            </thead>
            <tbody>
                <!--I have list of students I should for foreach in the list read data for each student-->
                @foreach (var student in Model)
            {
                <tr>
                    <td>@student.Id</td>
                    <td>@student.Name</td>
                    <td>@student.Email</td>
                    <td>@student.Age</td>
                    <!-- at the last column I will add Edit , Delete , Details links -->
                    <td>
                        <!--If it is a link I should provide href-->
                        <a href="/Student/Details/@student.Id">Details</a>
                        <a href="/Student/Edit/@student.Id">Edit</a>
                        <a href="/Student/Delete/@student.Id">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<h2>Students</h2>
<p>@Html.ActionLink("Details","Details","Student",new {id=3}) </p>