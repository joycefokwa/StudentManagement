@model StudentManagment.Models.Student

@{
    ViewBag.Title = "Delete";
}

<h2>Delete student </h2>

<div class="alert alert-warning">
    Are you sure you want to delete this student?
</div>

<dl>
    <dt>ID</dt>
    <dd>@Model.Id</dd>
    <dt>Name</dt>
    <dd>@Model.Name</dd>
    <dt>Email</dt>
    <dd>@Model.Email</dd>
    <dt>Age</dt>
    <dd>@Model.Age</dd>
</dl>

<!--Make button Delete work-->
<!-- submit delete I need Form-->
@using(Html.BeginForm("Delete","Student",FormMethod.Post))
  {
    @Html.AntiForgeryToken()
      <!--Hide the input , I want to hide id to delete-->
      <!-- Hideen Input (ID)-->
    @Html.HiddenFor(model => model.Id)

    <button type="submit" class="btn btn-danger">Delete</button>
    @Html.ActionLink("Cancel","Index" , new {@class = "btn btn-default"})
  }