@model StudentManagment.Models.Student
@{
    ViewBag.Title = "Edit";
}


<h2>Edit Student</h2>
<!--Existing information-->

<dl>
    <!--Dta List-->
    <dt>ID</dt> <!--Dt data Title and dd data-->
    <dd>@Model.Id</dd>
    <dt>Name</dt>
    <dd>@Model.Name</dd>
    <dt>Email</dt>
    <dd>@Model.Email</dd>
    <dt>Age</dt>
    <dd>@Model.Age</dd>
</dl>
<!--Start editing the student info-->
<!-- pass data , send data , I will use from -->

@using (Html.BeginForm("Edit", "Student", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <!--Edit the information-->
    <div class="form-group">
        @Html.LabelFor(model => model.Name)
        @Html.TextBoxFor(model => model.Name, new { @class = "from-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Email)
        @Html.TextBoxFor(model => model.Email, new { @class = "from-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Age)
        @Html.TextBoxFor(model => model.Age, new { @class = "from-control" })
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
}

